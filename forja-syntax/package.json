{
  "name": "forja-syntax",
  "displayName": "Forja (fa)",
  "description": "Soporte completo para el lenguaje Forja — sintaxis, LSP, compilación, debug, toolchain",
  "version": "0.9.7",
  "publisher": "forja-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forja-lang/forja.git"
  },
  "icon": "media/forge-anvil.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Debuggers",
    "Notebooks",
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:forja",
    "onCommand:forja.run",
    "onCommand:forja.runNative",
    "onCommand:forja.runRepl",
    "onCommand:forja.runDebug",
    "onCommand:forja.build",
    "onCommand:forja.buildASM",
    "onCommand:forja.buildAndroid",
    "onCommand:forja.buildAndroid.arm64",
    "onCommand:forja.buildAndroid.x86_64",
    "onCommand:forja.buildAndroid.all",
    "onCommand:forja.checkAndroidNDK",
    "onCommand:forja.deployAndroid",
    "onCommand:forja.test",
    "onCommand:forja.bench",
    "onCommand:forja.fmt",
    "onCommand:forja.doc",
    "onCommand:forja.diagram",
    "onCommand:forja.transpile",
    "onCommand:forja.hotReload",
    "onCommand:forja.hotRestart",
    "onCommand:forja.newProject",
    "onCommand:forja.selectVM",
    "onCommand:forja.selectTarget",
    "onCommand:forja.openConfig",
    "onCommand:forja.showOutput",
    "onCommand:forja.installToolchain",
    "onCommand:forja.openTutorial",
    "onCommand:forja.openDiagram",
    "onCommand:forja.toggleSidebar",
    "onCommand:forja.toggleHotReload",
    "onCommand:forja.openStdlib",
    "onCommand:forja.openFile",
    "onCommand:forja.revealLine",
    "onDebug",
    "onDebugInitialConfigurations",
    "onView:forja.diagram"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "forja",
        "aliases": [
          "Forja",
          "forja",
          "fa"
        ],
        "extensions": [
          ".fa"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "forja",
        "scopeName": "source.forja",
        "path": "./syntaxes/forja.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forja-sidebar",
          "title": "Forja",
          "icon": "$(zap)"
        }
      ]
    },
    "views": {
      "forja-sidebar": [
        {
          "type": "webview",
          "id": "forja.diagram",
          "name": "Diagramas",
          "icon": "$(graph)"
        }
      ],
      "panel": []
    },
    "debuggers": [
      {
        "type": "forja",
        "label": "Forja Debug",
        "languages": [
          "forja"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Ruta al archivo .fa a depurar",
                "default": "${file}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "forja",
            "request": "launch",
            "name": "Forja: Debug archivo activo",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Forja: Debug archivo activo",
            "description": "Depurar el archivo .fa activo",
            "body": {
              "type": "forja",
              "request": "launch",
              "name": "Forja: Debug archivo activo",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "forja.run",
        "title": "Forja: ejecutar",
        "icon": "$(play)"
      },
      {
        "command": "forja.runNative",
        "title": "Forja: ejecutar en modo nativo/GUI",
        "icon": "$(window)"
      },
      {
        "command": "forja.runRepl",
        "title": "Forja: abrir consola interactiva (REPL)",
        "icon": "$(terminal)"
      },
      {
        "command": "forja.runDebug",
        "title": "Forja: ejecutar en modo depuración",
        "icon": "$(bug)"
      },
      {
        "command": "forja.build",
        "title": "Forja: compilar a ejecutable",
        "icon": "$(gear)"
      },
      {
        "command": "forja.buildASM",
        "title": "Forja: compilar a ASM",
        "icon": "$(chip)"
      },
      {
        "command": "forja.buildAndroid",
        "title": "Forja: compilar para Android",
        "icon": "$(device-mobile)"
      },
      {
        "command": "forja.buildAndroid.arm64",
        "title": "Forja: compilar para Android ARM64",
        "icon": "$(device-mobile)"
      },
      {
        "command": "forja.buildAndroid.x86_64",
        "title": "Forja: compilar para Android x86_64",
        "icon": "$(device-mobile)"
      },
      {
        "command": "forja.buildAndroid.all",
        "title": "Forja: compilar para Android (todos los objetivos)",
        "icon": "$(device-mobile)"
      },
      {
        "command": "forja.checkAndroidNDK",
        "title": "Forja: verificar NDK Android",
        "icon": "$(check)"
      },
      {
        "command": "forja.deployAndroid",
        "title": "Forja: desplegar en dispositivo Android",
        "icon": "$(plug)"
      },
      {
        "command": "forja.test",
        "title": "Forja: ejecutar pruebas",
        "icon": "$(beaker)"
      },
      {
        "command": "forja.bench",
        "title": "Forja: medir rendimiento",
        "icon": "$(dashboard)"
      },
      {
        "command": "forja.fmt",
        "title": "Forja: formatear archivo",
        "icon": "$(paintcan)"
      },
      {
        "command": "forja.doc",
        "title": "Forja: generar documentación HTML",
        "icon": "$(book)"
      },
      {
        "command": "forja.diagram",
        "title": "Forja: generar diagrama",
        "icon": "$(graph)"
      },
      {
        "command": "forja.transpile",
        "title": "Forja: transpilar a Rust",
        "icon": "$(symbol-file)"
      },
      {
        "command": "forja.hotReload",
        "title": "Forja: recarga en caliente",
        "icon": "$(sync)"
      },
      {
        "command": "forja.hotRestart",
        "title": "Forja: reinicio en caliente",
        "icon": "$(refresh)"
      },
      {
        "command": "forja.newProject",
        "title": "Forja: crear nuevo proyecto",
        "icon": "$(new-folder)"
      },
      {
        "command": "forja.selectVM",
        "title": "Forja: seleccionar motor (forja.yaml)",
        "icon": "$(zap)"
      },
      {
        "command": "forja.selectTarget",
        "title": "Forja: seleccionar destino (forja.yaml)",
        "icon": "$(target)"
      },
      {
        "command": "forja.openConfig",
        "title": "Forja: abrir forja.yaml",
        "icon": "$(gear)"
      },
      {
        "command": "forja.showOutput",
        "title": "Forja: mostrar salida",
        "icon": "$(output)"
      },
      {
        "command": "forja.installToolchain",
        "title": "Forja: instalar o verificar el entorno de compilación",
        "icon": "$(package)"
      },
      {
        "command": "forja.openTutorial",
        "title": "Forja: abrir tutorial interactivo",
        "icon": "$(book)"
      },
      {
        "command": "forja.openDiagram",
        "title": "Forja: abrir visor de diagramas",
        "icon": "$(graph)"
      },
      {
        "command": "forja.toggleSidebar",
        "title": "Forja: alternar panel lateral",
        "icon": "$(sidebar-right)"
      },
      {
        "command": "forja.toggleHotReload",
        "title": "Forja: activar o desactivar recarga en caliente",
        "icon": "$(sync-ignored)"
      },
      {
        "command": "forja.openStdlib",
        "title": "Forja: abrir biblioteca estándar",
        "icon": "$(library)"
      },
      {
        "command": "forja.openFile",
        "title": "Forja: abrir archivo",
        "icon": "$(go-to-file)"
      },
      {
        "command": "forja.revealLine",
        "title": "Forja: ir a línea",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == forja",
          "command": "forja.run",
          "group": "navigation@1"
        },
        {
          "when": "resourceLangId == forja",
          "command": "forja.runNative",
          "group": "navigation@2"
        },
        {
          "when": "resourceLangId == forja",
          "command": "forja.runDebug",
          "group": "navigation@3"
        },
        {
          "when": "resourceLangId == forja",
          "command": "forja.hotReload",
          "group": "navigation@4"
        },
        {
          "when": "resourceLangId == forja",
          "command": "forja.hotRestart",
          "group": "navigation@5"
        },
        {
          "when": "resourceLangId == forja",
          "command": "forja.build",
          "group": "navigation@6"
        },
        {
          "when": "resourceLangId == forja",
          "command": "forja.selectVM",
          "group": "navigation@7"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId == forja",
          "command": "forja.run",
          "group": "forja@1"
        },
        {
          "when": "resourceLangId == forja",
          "command": "forja.runDebug",
          "group": "forja@2"
        },
        {
          "when": "resourceLangId == forja",
          "command": "forja.fmt",
          "group": "forja@3"
        },
        {
          "when": "resourceLangId == forja",
          "command": "forja.test",
          "group": "forja@4"
        },
        {
          "when": "resourceLangId == forja",
          "command": "forja.diagram",
          "group": "forja@5"
        },
        {
          "when": "resourceLangId == forja",
          "command": "forja.transpile",
          "group": "forja@6"
        }
      ],
      "commandPalette": []
    },
    "keybindings": [
      {
        "command": "forja.run",
        "key": "ctrl+alt+r",
        "when": "editorLangId == forja"
      },
      {
        "command": "forja.runNative",
        "key": "ctrl+alt+g",
        "when": "editorLangId == forja"
      },
      {
        "command": "forja.runDebug",
        "key": "ctrl+alt+d",
        "when": "editorLangId == forja"
      },
      {
        "command": "forja.fmt",
        "key": "ctrl+alt+l",
        "when": "editorLangId == forja"
      },
      {
        "command": "forja.test",
        "key": "ctrl+alt+t",
        "when": "editorLangId == forja"
      },
      {
        "command": "forja.runRepl",
        "key": "ctrl+alt+p",
        "when": "editorLangId == forja"
      },
      {
        "command": "forja.hotReload",
        "key": "ctrl+alt+h",
        "when": "editorLangId == forja"
      },
      {
        "command": "forja.hotRestart",
        "key": "ctrl+shift+r",
        "when": "editorLangId == forja"
      },
      {
        "command": "forja.openTutorial",
        "key": "ctrl+alt+e",
        "when": "editorLangId == forja"
      },
      {
        "command": "forja.openConfig",
        "key": "ctrl+alt+c",
        "when": "editorLangId == forja"
      }
    ],
    "configuration": {
      "title": "Forja",
      "properties": {
        "forja.command": {
          "type": "string",
          "default": "forja",
          "description": "Comando o ruta absoluta al ejecutable de la CLI Forja."
        },
        "forja.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Ruta al binario del LSP server forja-lsp. Vacío = auto-detect en PATH o target/."
        },
        "forja.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar/deshabilitar el servidor LSP."
        },
        "forja.terminal.preserveFocus": {
          "type": "boolean",
          "default": false,
          "description": "Mantener el foco en el editor al ejecutar comandos."
        },
        "forja.terminal.clearBeforeRun": {
          "type": "boolean",
          "default": false,
          "description": "Limpiar la terminal antes de ejecutar."
        },
        "forja.hotReload.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar recarga en caliente automática al guardar archivos .fa."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "forja",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "Tarea Forja a ejecutar: run, test, bench, build, build-asm, fmt"
          }
        }
      }
    ],
    "snippets": [
      {
        "language": "forja",
        "path": "./snippets/forja.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.60.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.0"
  }
}
